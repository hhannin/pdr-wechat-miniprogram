<view class="container">
  <view class="title">PDR Sensor Debug</view>
  <view class="status">
    Status: {{running ? "Running" : "Stopped"}}
  </view>
  <view class="data">
    <text>ax: {{ax}}</text>
    <text>ay: {{ay}}</text>
    <text>az: {{az}}</text>
    <text>gx: {{gx}}</text>
    <text>gy: {{gy}}</text>
    <text>gz: {{gz}}</text>
    <text>Gravity X: {{gravityX}}</text>
    <text>Gravity Y: {{gravityY}}</text>
    <text>Gravity Z: {{gravityZ}}</text>
    <text>时间戳: {{timestamp}}</text>
    <text>时间: {{timeString}}</text>
    <text>步数: {{stepCount}}</text>
    <text>步频(Hz): {{stepFreq}}</text>
  </view>

  <!-- Canvas 显示重力箭头 -->
  <view class="canvas-container">
    <canvas id="gravityCanvas" canvas-id="gravityCanvas" type="2d" style="width:300px;height:300px;background:#111;border:1px solid #0f0;"></canvas>
  </view>

  <button bindtap="toggle">
    {{running ? "Stop" : "Start"}}
  </button>
</view>
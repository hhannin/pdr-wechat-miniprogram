<view class="page-shell">
  <view class="hero-card">
    <view class="hero-title">Foots Debug</view>
    <view class="hero-subtitle">
      最小闭环：地图选点、拍照、本地创建、可编辑字段更新、最近记录、微信地图回找。
    </view>
  </view>

  <view class="status-card" wx:if="{{busy || statusText || errorText}}">
    <view class="status-line status-busy" wx:if="{{busy}}">
      处理中：{{busyText}}
    </view>
    <view class="status-line status-success" wx:if="{{statusText}}">
      {{statusText}}
    </view>
    <view class="status-line status-error" wx:if="{{errorText}}">
      {{errorText}}
    </view>
  </view>

  <view class="toolbar-row">
    <button size="mini" bindtap="handleRefreshTap" loading="{{busy}}" disabled="{{busy}}">
      刷新列表
    </button>
    <button size="mini" bindtap="handleStartNew" disabled="{{busy}}">
      新建模式
    </button>
  </view>

  <view class="panel-card">
    <view class="panel-title">{{editorTitle}}</view>
    <view class="panel-desc">{{editorHint}}</view>

    <view class="meta-grid" wx:if="{{isEditMode}}">
      <view class="meta-item">
        <text class="meta-label">ID</text>
        <text class="meta-value">{{selectedItemId}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-label">创建时间</text>
        <text class="meta-value">{{selectedItemCreatedAt}}</text>
      </view>
      <view class="meta-item">
        <text class="meta-label">更新时间</text>
        <text class="meta-value">{{selectedItemUpdatedAt}}</text>
      </view>
    </view>

    <view class="field-group">
      <view class="field-label">场景</view>
      <picker
        mode="selector"
        range="{{sceneOptions}}"
        range-key="label"
        value="{{selectedSceneIndex}}"
        bindchange="handleSceneChange"
        disabled="{{busy}}"
      >
        <view class="picker-box">
          {{sceneOptions[selectedSceneIndex].label}}
        </view>
      </picker>
      <view class="field-desc">{{sceneDescription}}</view>
    </view>

    <view class="field-group">
      <view class="field-label">位置</view>
      <view class="info-box">
        <view class="info-title {{hasLocation ? '' : 'placeholder-text'}}">
          {{locationTitle}}
        </view>
        <view class="info-subtitle">{{locationSubtitle}}</view>
        <view class="info-tag" wx:if="{{locationSourceText}}">
          {{locationSourceText}}
        </view>
      </view>
      <view class="button-row">
        <button
          size="mini"
          bindtap="handlePickCurrentLocation"
          disabled="{{busy || isEditMode}}"
        >
          地图选当前位置
        </button>
        <button
          size="mini"
          bindtap="handlePickManualLocation"
          disabled="{{busy || isEditMode}}"
        >
          地图选其他位置
        </button>
        <button
          size="mini"
          bindtap="handleOpenLocation"
          disabled="{{busy || !hasLocation}}"
        >
          打开地图
        </button>
      </view>
    </view>

    <view class="field-group">
      <view class="field-label">照片线索</view>
      <view class="info-box">
        <image
          wx:if="{{hasPhoto}}"
          class="photo-preview"
          src="{{photoPath}}"
          mode="aspectFill"
        />
        <view class="info-subtitle {{hasPhoto ? '' : 'placeholder-text'}}">
          {{photoMeta}}
        </view>
      </view>
      <view class="button-row" wx:if="{{!isEditMode}}">
        <button size="mini" bindtap="handleCapturePhoto" disabled="{{busy}}">
          拍一张线索照片
        </button>
        <button
          size="mini"
          bindtap="handleClearDraftPhoto"
          disabled="{{busy || !hasPhoto}}"
        >
          清除照片
        </button>
      </view>
      <view class="button-row" wx:if="{{isEditMode && !hasPhoto}}">
        <button size="mini" bindtap="handleCapturePhoto" disabled="{{busy}}">
          补一张线索照片
        </button>
      </view>
    </view>

    <view class="field-group" wx:if="{{draftFieldViews.length > 0}}">
      <view class="field-label">语义锚点</view>
      <block wx:for="{{draftFieldViews}}" wx:key="key">
        <view class="anchor-row">
          <view class="anchor-head">
            <view class="anchor-title">{{item.label}}</view>
            <view class="anchor-badges">
              <text class="badge" wx:if="{{item.primary}}">核心</text>
              <text class="badge" wx:if="{{item.required}}">必填</text>
            </view>
          </view>
          <picker
            mode="selector"
            range="{{item.options}}"
            range-key="label"
            value="{{item.selectedIndex}}"
            data-field-key="{{item.key}}"
            bindchange="handleFieldChange"
            disabled="{{busy}}"
          >
            <view class="picker-box {{item.isEmpty ? 'placeholder-text' : ''}}">
              {{item.selectedLabel}}
            </view>
          </picker>
          <view class="field-desc" wx:if="{{item.description}}">
            {{item.description}}
          </view>
        </view>
      </block>
    </view>

    <view class="field-group">
      <view class="field-label">备注</view>
      <textarea
        class="note-input"
        auto-height
        maxlength="2000"
        value="{{noteValue}}"
        placeholder="补充最后 50 米回找信息，比如柱子编号、门牌、附近店铺、电梯厅等。"
        bindinput="handleNoteInput"
        disabled="{{busy}}"
      />
      <view class="field-desc">当前字数：{{noteLength}} / 2000</view>
    </view>

    <view class="action-column" wx:if="{{!isEditMode}}">
      <button
        class="primary-button"
        bindtap="handleCreate"
        loading="{{busy}}"
        disabled="{{busy || !canCreate}}"
      >
        创建记录
      </button>
    </view>

    <view class="action-column" wx:if="{{isEditMode}}">
      <button
        class="primary-button"
        bindtap="handleSaveEdit"
        loading="{{busy}}"
        disabled="{{busy || !canSaveEdit}}"
      >
        保存可编辑字段
      </button>
      <button
        class="danger-button"
        bindtap="handleDeleteItem"
        loading="{{busy}}"
        disabled="{{busy}}"
      >
        删除当前记录
      </button>
    </view>
  </view>

  <view class="panel-card">
    <view class="panel-title">最近记录</view>
    <view class="panel-desc">点击任意记录可切换到编辑态，点“打开地图”可直接回找。</view>

    <view class="empty-state" wx:if="{{recentItems.length === 0}}">
      还没有本地记录，先用上面的表单创建一条。
    </view>

    <block wx:for="{{recentItems}}" wx:key="id">
      <view class="recent-card {{item.isActive ? 'recent-card-active' : ''}}">
        <image
          wx:if="{{item.hasPhoto}}"
          class="recent-cover"
          src="{{item.coverPhotoPath}}"
          mode="aspectFill"
        />
        <view class="recent-body">
          <view class="recent-title">{{item.title}}</view>
          <view class="recent-subtitle">{{item.subtitle}}</view>
          <view class="recent-meta">{{item.meta}}</view>
          <view class="recent-anchor-text">{{item.anchorsText}}</view>
          <view class="recent-note-text">{{item.noteText}}</view>
          <button
            size="mini"
            data-item-id="{{item.id}}"
            bindtap="handleSelectRecentItem"
            disabled="{{busy}}"
          >
            查看 / 编辑
          </button>
        </view>
      </view>
    </block>
  </view>

  <view class="panel-card" wx:if="{{selectedItemDebugJson}}">
    <view class="panel-title">当前记录 Debug JSON</view>
    <view class="code-block">{{selectedItemDebugJson}}</view>
  </view>
</view>

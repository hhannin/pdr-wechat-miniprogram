<view class="page-shell">
  <view class="status-card" wx:if="{{busy || statusText || errorText}}">
    <view class="status-line status-busy" wx:if="{{busy}}">
      {{busyText}}
    </view>
    <view class="status-line status-success" wx:if="{{statusText}}">
      {{statusText}}
    </view>
    <view class="status-line status-error" wx:if="{{errorText}}">
      {{errorText}}
    </view>
  </view>

  <view class="records-list" wx:if="{{pageReady && hasItems}}">
    <block wx:for="{{items}}" wx:key="id" wx:for-item="item">
      <view class="record-row">
        <view class="record-actions">
          <view
            class="record-action record-action-edit {{item.isSwipeOpen ? 'record-action-visible' : ''}}"
            catchtap="handleEditTap"
            data-item-id="{{item.id}}"
          >
            编辑
          </view>
          <view
            class="record-action record-action-delete {{item.isSwipeOpen ? 'record-action-visible' : ''}}"
            catchtap="handleDeleteTap"
            data-item-id="{{item.id}}"
          >
            删除
          </view>
        </view>

        <view
          class="record-card {{item.isSwipeOpen ? 'record-card-open' : ''}} {{item.isHighlighted ? 'record-card-highlighted' : ''}}"
          data-item-id="{{item.id}}"
          bindtap="handleCardTap"
          bindtouchstart="handleCardTouchStart"
          bindtouchend="handleCardTouchEnd"
        >
          <image wx:if="{{item.hasPhoto}}" class="record-photo" src="{{item.coverPhotoPath}}" mode="aspectFill" />
          <view class="record-body">
            <view class="record-head">
              <view class="record-scene">{{item.sceneLabel}}</view>
              <view class="record-meta">{{item.meta}}</view>
            </view>
            <view class="record-title">{{item.title}}</view>
            <view class="record-subtitle">{{item.subtitle}}</view>
            <view class="record-anchors">{{item.anchorsText}}</view>
            <view class="record-note">{{item.noteText}}</view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <view class="empty-card" wx:if="{{pageReady && !hasItems}}">
    <view class="empty-figure">
      <view class="empty-circle empty-circle-large"></view>
      <view class="empty-circle empty-circle-small"></view>
      <view class="empty-card-shape"></view>
    </view>
    <view class="empty-title">还没有记录</view>
    <view class="empty-desc">去记一个位置。</view>
    <navigator class="empty-action" url="{{footerNavItems[0].path}}" open-type="redirect">
      去新建
    </navigator>
  </view>

  <view class="loading-card" wx:if="{{!pageReady}}">
    <view class="loading-title">读取中</view>
  </view>

  <view class="footer-nav">
    <block wx:for="{{footerNavItems}}" wx:key="key" wx:for-item="navItem">
      <navigator
        class="footer-nav-item {{navItem.isActive ? 'footer-nav-item-active' : ''}}"
        url="{{navItem.path}}"
        open-type="redirect"
      >
        <view class="footer-nav-label">{{navItem.label}}</view>
      </navigator>
    </block>
  </view>
</view>

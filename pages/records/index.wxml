<view class="page-shell">
  <view class="records-list" wx:if="{{pageReady && hasItems}}">
    <view class="records-pinned-shell" wx:if="{{hasPinnedItems}}">
      <view class="records-pinned-header" bindtap="handleTogglePinnedSection">
        <view class="records-pinned-copy">
          <view class="records-pinned-title">置顶</view>
          <view class="records-pinned-count">{{pinnedItems.length}} 条</view>
        </view>
        <view class="records-pinned-toggle">{{pinnedSectionCollapsed ? '展开' : '收起'}}</view>
      </view>

      <view class="records-pinned-list" wx:if="{{!pinnedSectionCollapsed}}">
        <block wx:for="{{pinnedItems}}" wx:key="rowKey" wx:for-item="item">
          <view class="record-row">
            <view class="record-actions">
              <view
                class="record-action record-action-edit {{item.isSwipeOpen ? 'record-action-visible' : ''}}"
                catchtap="handleEditTap"
                data-item-id="{{item.id}}"
              >
                编辑
              </view>
              <view
                class="record-action record-action-pin {{item.isSwipeOpen ? 'record-action-visible' : ''}}"
                catchtap="handlePinTap"
                data-item-id="{{item.id}}"
              >
                {{item.pinActionLabel}}
              </view>
              <view
                class="record-action record-action-delete {{item.isSwipeOpen ? 'record-action-visible' : ''}}"
                catchtap="handleDeleteTap"
                data-item-id="{{item.id}}"
              >
                删除
              </view>
            </view>

            <view
              class="record-card {{item.isSwipeOpen ? 'record-card-open' : ''}} {{item.isHighlighted ? 'record-card-highlighted' : ''}}"
              data-item-id="{{item.id}}"
              data-row-key="{{item.rowKey}}"
              bindtap="handleCardTap"
              bindtouchstart="handleCardTouchStart"
              bindtouchend="handleCardTouchEnd"
              hover-class="record-card-pressed"
            >
              <view class="record-card-layout">
                <view class="record-thumb">
                  <image wx:if="{{item.hasPhoto}}" class="record-photo" src="{{item.coverPhotoPath}}" mode="aspectFill" />
                  <view wx:else class="record-photo-empty">无照片</view>
                </view>
                <view class="record-body">
                  <view class="record-title">{{item.title}}</view>
                  <view class="record-subtitle">{{item.subtitle}}</view>
                  <view class="record-meta">
                    <view class="record-time">{{item.timestampText}}</view>
                    <view class="record-meta-tags">
                      <view wx:if="{{item.hasReminderTag}}" class="record-reminder-tag {{item.reminderTagClassName}}">提醒</view>
                      <view class="record-scene">{{item.sceneLabel}}</view>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view class="records-reminder-shell" wx:if="{{hasReminderItems}}">
      <view class="records-reminder-header" bindtap="handleToggleReminderSection">
        <view class="records-reminder-copy">
          <view class="records-reminder-title">提醒</view>
          <view class="records-reminder-count">{{reminderItems.length}} 条</view>
        </view>
        <view class="records-reminder-toggle">{{reminderSectionCollapsed ? '展开' : '收起'}}</view>
      </view>

      <view class="records-reminder-list" wx:if="{{!reminderSectionCollapsed}}">
        <block wx:for="{{reminderItems}}" wx:key="rowKey" wx:for-item="item">
          <view class="record-row">
            <view class="record-actions">
              <view
                class="record-action record-action-edit {{item.isSwipeOpen ? 'record-action-visible' : ''}}"
                catchtap="handleEditTap"
                data-item-id="{{item.id}}"
              >
                编辑
              </view>
              <view
                class="record-action record-action-pin {{item.isSwipeOpen ? 'record-action-visible' : ''}}"
                catchtap="handlePinTap"
                data-item-id="{{item.id}}"
              >
                {{item.pinActionLabel}}
              </view>
              <view
                class="record-action record-action-delete {{item.isSwipeOpen ? 'record-action-visible' : ''}}"
                catchtap="handleDeleteTap"
                data-item-id="{{item.id}}"
              >
                删除
              </view>
            </view>

            <view
              class="record-card {{item.isSwipeOpen ? 'record-card-open' : ''}} {{item.isHighlighted ? 'record-card-highlighted' : ''}}"
              data-item-id="{{item.id}}"
              data-row-key="{{item.rowKey}}"
              bindtap="handleCardTap"
              bindtouchstart="handleCardTouchStart"
              bindtouchend="handleCardTouchEnd"
              hover-class="record-card-pressed"
            >
              <view class="record-card-layout">
                <view class="record-thumb">
                  <image wx:if="{{item.hasPhoto}}" class="record-photo" src="{{item.coverPhotoPath}}" mode="aspectFill" />
                  <view wx:else class="record-photo-empty">无照片</view>
                </view>
                <view class="record-body">
                  <view class="record-title">{{item.title}}</view>
                  <view class="record-subtitle">{{item.subtitle}}</view>
                  <view class="record-meta">
                    <view class="record-time">{{item.timestampText}}</view>
                    <view class="record-meta-tags">
                      <view wx:if="{{item.hasReminderTag}}" class="record-reminder-tag {{item.reminderTagClassName}}">提醒</view>
                      <view class="record-scene">{{item.sceneLabel}}</view>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <block wx:for="{{groups}}" wx:key="key" wx:for-item="group">
      <view class="records-group">
        <view class="records-group-title">{{group.title}}</view>

        <block wx:for="{{group.items}}" wx:key="rowKey" wx:for-item="item">
          <view class="record-row">
            <view class="record-actions">
              <view
                class="record-action record-action-edit {{item.isSwipeOpen ? 'record-action-visible' : ''}}"
                catchtap="handleEditTap"
                data-item-id="{{item.id}}"
              >
                编辑
              </view>
              <view
                class="record-action record-action-pin {{item.isSwipeOpen ? 'record-action-visible' : ''}}"
                catchtap="handlePinTap"
                data-item-id="{{item.id}}"
              >
                {{item.pinActionLabel}}
              </view>
              <view
                class="record-action record-action-delete {{item.isSwipeOpen ? 'record-action-visible' : ''}}"
                catchtap="handleDeleteTap"
                data-item-id="{{item.id}}"
              >
                删除
              </view>
            </view>

            <view
              class="record-card {{item.isSwipeOpen ? 'record-card-open' : ''}} {{item.isHighlighted ? 'record-card-highlighted' : ''}}"
              data-item-id="{{item.id}}"
              data-row-key="{{item.rowKey}}"
              bindtap="handleCardTap"
              bindtouchstart="handleCardTouchStart"
              bindtouchend="handleCardTouchEnd"
              hover-class="record-card-pressed"
            >
              <view class="record-card-layout">
                <view class="record-thumb">
                  <image wx:if="{{item.hasPhoto}}" class="record-photo" src="{{item.coverPhotoPath}}" mode="aspectFill" />
                  <view wx:else class="record-photo-empty">无照片</view>
                </view>
                <view class="record-body">
                  <view class="record-title">{{item.title}}</view>
                  <view class="record-subtitle">{{item.subtitle}}</view>
                  <view class="record-meta">
                    <view class="record-time">{{item.timestampText}}</view>
                    <view class="record-meta-tags">
                      <view wx:if="{{item.hasReminderTag}}" class="record-reminder-tag {{item.reminderTagClassName}}">提醒</view>
                      <view class="record-scene">{{item.sceneLabel}}</view>
                    </view>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </block>
      </view>
    </block>
  </view>

  <view class="empty-card" wx:if="{{pageReady && !hasItems}}">
    <view class="empty-figure">
      <view class="empty-circle empty-circle-large"></view>
      <view class="empty-circle empty-circle-small"></view>
      <view class="empty-card-shape"></view>
    </view>
    <view class="empty-title">还没记下位置</view>
    <view class="empty-desc">去记一个地方。</view>
    <navigator class="empty-action" url="{{footerNavItems[0].path}}" open-type="redirect">
      去记一个
    </navigator>
  </view>

  <view class="loading-card" wx:if="{{!pageReady}}">
    <view class="loading-title">载入中</view>
  </view>

  <view class="footer-nav">
    <block wx:for="{{footerNavItems}}" wx:key="key" wx:for-item="navItem">
      <navigator
        class="footer-nav-item {{navItem.isActive ? 'footer-nav-item-active' : ''}}"
        url="{{navItem.path}}"
        open-type="redirect"
        hover-class="footer-nav-item-pressed"
      >
        <view class="footer-nav-label">{{navItem.label}}</view>
      </navigator>
    </block>
  </view>
</view>

.page-shell {
  min-height: 100vh;
  padding: 18rpx 28rpx 224rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top right, rgba(199, 141, 63, 0.18), transparent 32%),
    radial-gradient(circle at top left, rgba(31, 106, 70, 0.12), transparent 28%),
    linear-gradient(180deg, #fbf7f1 0%, #f4efe5 62%, #efe8da 100%);
  color: #223c2b;
}

.section-card,
.loading-card {
  background: rgba(255, 251, 245, 0.92);
  border: 1px solid rgba(34, 60, 43, 0.1);
  border-radius: 32rpx;
  box-shadow: 0 22rpx 54rpx rgba(49, 42, 27, 0.1);
}

.section-card,
.loading-card {
  padding: 30rpx 28rpx;
  margin-bottom: 24rpx;
}

.section-head,
.field-head,
.button-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  flex-wrap: wrap;
}

.record-chip,
.field-badge {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.record-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 68rpx;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.record-strip-shell {
  position: sticky;
  top: 0;
  z-index: 10;
  margin: -18rpx -28rpx 18rpx;
  padding: 18rpx 28rpx 14rpx;
  background:
    linear-gradient(180deg, rgba(251, 247, 241, 0.96), rgba(244, 239, 229, 0.92));
  backdrop-filter: blur(16rpx);
}

.record-strip-shell .record-strip {
  margin-bottom: 0;
}

.record-strip-copy {
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}

.record-chip {
  background: rgba(31, 106, 70, 0.12);
  color: #174f35;
}

.record-chip-muted,
.field-badge {
  background: rgba(199, 141, 63, 0.14);
  color: #7a5225;
}

.record-share-slot {
  flex: 0 0 176rpx;
  width: 176rpx;
  height: 68rpx;
}

.record-share-button,
.record-share-placeholder {
  width: 100%;
  height: 100%;
}

.record-share-button {
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(31, 106, 70, 0.1);
  border: 1px solid rgba(31, 106, 70, 0.16);
  color: #174f35;
  box-sizing: border-box;
}

.record-share-button-disabled {
  opacity: 0.45;
  pointer-events: none;
}

.record-share-placeholder {
  visibility: hidden;
}

.record-share-text {
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
}

.hero-subtitle,
.section-desc,
.field-desc,
.note-text {
  font-size: 25rpx;
  line-height: 1.7;
  color: rgba(34, 60, 43, 0.68);
}

.section-title,
.field-title {
  font-size: 31rpx;
  font-weight: 700;
  color: #223c2b;
}

.photo-card {
  padding: 22rpx;
}

.photo-stage {
  position: relative;
  min-height: 520rpx;
  border-radius: 28rpx;
  background:
    linear-gradient(180deg, rgba(244, 239, 229, 0.78), rgba(250, 246, 239, 0.96));
  border: 1px solid rgba(34, 60, 43, 0.08);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-stage-empty {
  border-style: dashed;
}

.photo-stage-tappable {
  transition: transform 160ms ease, box-shadow 160ms ease;
}

.photo-stage-disabled {
  opacity: 0.7;
}

.stage-clear {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  z-index: 3;
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(34, 60, 43, 0.58);
  color: #fffaf3;
  font-size: 34rpx;
  line-height: 1;
}

.photo-empty-shell {
  width: 100%;
  min-height: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  box-sizing: border-box;
}

.photo-empty-icon {
  width: 196rpx;
  height: 196rpx;
}

.photo-preview {
  width: 100%;
  height: 520rpx;
  display: block;
}

.photo-meta-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.photo-meta {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(34, 60, 43, 0.66);
}

.field-static,
.note-view,
.field-input,
.note-input {
  margin-top: 18rpx;
  border-radius: 24rpx;
  background: rgba(244, 239, 229, 0.76);
  border: 1px solid rgba(34, 60, 43, 0.08);
}

.field-static,
.note-view {
  padding: 22rpx 20rpx;
}

.location-title,
.field-static-value {
  font-size: 29rpx;
  line-height: 1.5;
  font-weight: 600;
  color: #223c2b;
}

.location-title {
  font-size: 33rpx;
  line-height: 1.42;
}

.field-input {
  width: 100%;
  height: 88rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  color: #223c2b;
  font-size: 27rpx;
}

.location-card {
  padding: 26rpx 24rpx;
}

.location-stage {
  position: relative;
  border-radius: 28rpx;
  background:
    linear-gradient(180deg, rgba(244, 239, 229, 0.78), rgba(250, 246, 239, 0.96));
  border: 1px solid rgba(34, 60, 43, 0.08);
  padding: 28rpx 24rpx;
}

.location-stage-disabled {
  opacity: 0.7;
}

.location-stage-shell,
.location-shell {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.location-stage-icon,
.location-icon {
  flex: 0 0 68rpx;
  width: 68rpx;
  height: 68rpx;
  margin-top: 4rpx;
}

.location-stage-copy,
.location-copy {
  flex: 1;
  min-width: 0;
}

.location-subtitle,
.location-source {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(34, 60, 43, 0.66);
}

.location-footer {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.inline-button {
  min-width: 220rpx;
  height: 76rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: rgba(31, 106, 70, 0.1);
  border: 1px solid rgba(31, 106, 70, 0.12);
  color: #214b35;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 76rpx;
}

.note-input {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx;
  box-sizing: border-box;
  color: #223c2b;
  font-size: 27rpx;
  line-height: 1.7;
}

.placeholder-text {
  color: rgba(34, 60, 43, 0.42);
}

.field-block + .field-block {
  margin-top: 22rpx;
}

.note-meta {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: rgba(34, 60, 43, 0.58);
}

.suggestion-wrap {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.suggestion-chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  border: 1px solid rgba(31, 106, 70, 0.14);
  background: rgba(255, 255, 255, 0.55);
  color: #335440;
  font-size: 22rpx;
  line-height: 1.3;
}

.suggestion-chip-active {
  border-color: rgba(31, 106, 70, 0.34);
  background: rgba(31, 106, 70, 0.12);
  color: #174f35;
}

.action-dock {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(constant(safe-area-inset-bottom) + 20rpx);
  bottom: calc(env(safe-area-inset-bottom) + 20rpx);
  z-index: 12;
}

.action-stack {
  box-sizing: border-box;
  padding: 12rpx;
  border-radius: 28rpx;
  border: 1px solid rgba(34, 60, 43, 0.08);
  background: rgba(255, 251, 245, 0.96);
  box-shadow: 0 18rpx 36rpx rgba(44, 38, 27, 0.12);
  display: flex;
  align-items: stretch;
  gap: 12rpx;
  overflow: hidden;
}

.action-stack-single .action-button {
  width: 100%;
}

.action-button {
  width: 100%;
  height: 84rpx;
  min-width: 0;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  transition: opacity 160ms ease, transform 160ms ease, background 160ms ease;
}

.action-stack-dual .action-button {
  flex: 0 0 calc((100% - 12rpx) / 2);
  width: calc((100% - 12rpx) / 2);
}

.action-button-primary {
  background: #1f6a46;
  border: 1px solid #1f6a46;
  color: #fffaf3;
}

.action-button-secondary {
  background: rgba(255, 251, 245, 0.98);
  border: 1px solid rgba(34, 60, 43, 0.12);
  color: #304739;
}

.action-button-danger {
  background: #f8edea;
  border: 1px solid rgba(140, 51, 64, 0.14);
  color: #8a3943;
}

.action-button-disabled {
  opacity: 0.45;
  pointer-events: none;
}

.action-button-pressed {
  transform: translateY(1rpx);
}

.action-button-native {
  padding: 0;
  line-height: 84rpx;
}

.action-button-native::after {
  border: none;
}

.action-button-loading {
  pointer-events: none;
}

.share-dialog-overlay {
  position: fixed;
  inset: 0;
  z-index: 24;
  padding: 36rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.share-dialog-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(29, 32, 26, 0.3);
}

.share-dialog {
  position: relative;
  width: 100%;
  max-width: 620rpx;
  border-radius: 34rpx;
  overflow: hidden;
  border: 1px solid rgba(34, 60, 43, 0.08);
  box-shadow: 0 28rpx 72rpx rgba(44, 38, 27, 0.18);
  background: rgba(255, 251, 245, 0.98);
}

.share-dialog-header {
  padding: 28rpx 28rpx 22rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-bottom: 1px solid rgba(34, 60, 43, 0.06);
}

.share-dialog-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #223c2b;
}

.share-dialog-close {
  width: 60rpx;
  height: 60rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(244, 239, 229, 0.88);
  border: 1px solid rgba(34, 60, 43, 0.08);
}

.share-dialog-close-icon {
  width: 28rpx;
  height: 28rpx;
}

.share-dialog-body {
  padding: 10rpx 28rpx 0;
}

.share-dialog-row {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 0;
}

.share-dialog-row + .share-dialog-row {
  border-top: 1px solid rgba(34, 60, 43, 0.06);
}

.share-dialog-copy {
  flex: 1;
  min-width: 0;
}

.share-dialog-label {
  font-size: 28rpx;
  line-height: 1.5;
  font-weight: 600;
  color: #223c2b;
}

.share-choice-box {
  flex: 0 0 auto;
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  border: 2rpx solid rgba(34, 60, 43, 0.16);
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 251, 245, 0.98);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.9);
}

.share-choice-box-active {
  border-color: #1f6a46;
  background: rgba(31, 106, 70, 0.08);
}

.share-choice-box-locked {
  border-color: rgba(34, 60, 43, 0.12);
  background: rgba(244, 239, 229, 0.94);
}

.share-choice-check {
  font-size: 26rpx;
  line-height: 1;
  font-weight: 700;
  color: #1f6a46;
}

.share-choice-box-locked .share-choice-check {
  color: rgba(34, 60, 43, 0.36);
}

.share-dialog-footer {
  padding: 18rpx 28rpx 28rpx;
}

.share-dialog-button-slot {
  width: 100%;
  min-height: 84rpx;
}

.share-dialog-button {
  width: 100%;
  min-width: 100%;
  max-width: 100%;
  height: 84rpx;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.share-dialog-hint {
  margin-top: 14rpx;
  text-align: center;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(34, 60, 43, 0.52);
}

.share-loading-spinner {
  width: 34rpx;
  height: 34rpx;
  border-radius: 999rpx;
  border: 4rpx solid rgba(255, 250, 243, 0.38);
  border-top-color: #fffaf3;
  animation: share-spin 0.9s linear infinite;
}

button.share-dialog-button::after {
  border: none;
}

@keyframes share-spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

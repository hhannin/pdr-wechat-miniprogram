.page-shell {
  min-height: 100vh;
  padding: 32rpx 28rpx 72rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top right, rgba(199, 141, 63, 0.18), transparent 32%),
    radial-gradient(circle at top left, rgba(31, 106, 70, 0.12), transparent 28%),
    linear-gradient(180deg, #fbf7f1 0%, #f4efe5 62%, #efe8da 100%);
  color: #223c2b;
}

.hero-card,
.status-card,
.section-card,
.meta-card {
  background: rgba(255, 251, 245, 0.92);
  border: 1px solid rgba(34, 60, 43, 0.1);
  border-radius: 32rpx;
  box-shadow: 0 22rpx 54rpx rgba(49, 42, 27, 0.1);
}

.hero-card,
.section-card,
.meta-card {
  padding: 30rpx 28rpx;
  margin-bottom: 24rpx;
}

.status-card {
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
}

.hero-head,
.section-head,
.field-head,
.button-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  flex-wrap: wrap;
}

.hero-kicker,
.hero-mode,
.info-tag,
.field-badge {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.hero-kicker {
  background: rgba(31, 106, 70, 0.12);
  color: #174f35;
}

.hero-mode,
.field-badge,
.info-tag {
  background: rgba(199, 141, 63, 0.14);
  color: #7a5225;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 52rpx;
  line-height: 1.16;
  font-weight: 700;
}

.hero-subtitle,
.section-desc,
.field-desc,
.info-subtitle,
.note-text,
.meta-label,
.status-line,
.meta-value {
  font-size: 25rpx;
  line-height: 1.7;
  color: rgba(34, 60, 43, 0.68);
}

.hero-subtitle {
  margin-top: 14rpx;
}

.status-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.status-busy {
  color: #6a7d96;
}

.status-success {
  color: #20563a;
}

.status-error {
  color: #8c3340;
}

.section-title,
.field-title {
  font-size: 31rpx;
  font-weight: 700;
  color: #223c2b;
}

.section-desc {
  margin-top: 8rpx;
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(1, minmax(0, 1fr));
  gap: 14rpx;
}

.meta-item {
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(244, 239, 229, 0.7);
  border: 1px solid rgba(34, 60, 43, 0.06);
}

.meta-value {
  margin-top: 6rpx;
  color: #223c2b;
}

.info-panel,
.field-static,
.note-view,
.field-input,
.note-input {
  margin-top: 18rpx;
  border-radius: 24rpx;
  background: rgba(244, 239, 229, 0.76);
  border: 1px solid rgba(34, 60, 43, 0.08);
}

.info-panel,
.field-static,
.note-view {
  padding: 22rpx 20rpx;
}

.info-title,
.field-static-value {
  font-size: 29rpx;
  line-height: 1.5;
  font-weight: 600;
  color: #223c2b;
}

.field-input {
  width: 100%;
  height: 88rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  color: #223c2b;
  font-size: 27rpx;
}

.note-input {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx;
  box-sizing: border-box;
  color: #223c2b;
  font-size: 27rpx;
  line-height: 1.7;
}

.placeholder-text {
  color: rgba(34, 60, 43, 0.42);
}

.button-row {
  margin-top: 18rpx;
}

.photo-preview {
  width: 100%;
  height: 320rpx;
  border-radius: 20rpx;
  display: block;
}

.field-block + .field-block {
  margin-top: 22rpx;
}

.suggestion-wrap {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.suggestion-chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  border: 1px solid rgba(31, 106, 70, 0.14);
  background: rgba(255, 255, 255, 0.55);
  color: #335440;
  font-size: 22rpx;
  line-height: 1.3;
}

.suggestion-chip-active {
  border-color: rgba(31, 106, 70, 0.34);
  background: rgba(31, 106, 70, 0.12);
  color: #174f35;
}

.action-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 6rpx;
}

.primary-button,
.soft-button,
.outline-button,
.danger-button {
  width: 100%;
  border-radius: 999rpx;
}

.primary-button {
  background: linear-gradient(135deg, #1f6a46, #2b7c55);
  color: #f7fff9;
}

.soft-button {
  background: rgba(31, 106, 70, 0.12);
  color: #174f35;
}

.outline-button {
  background: rgba(255, 255, 255, 0.72);
  color: #223c2b;
  border: 1px solid rgba(34, 60, 43, 0.08);
}

.danger-button {
  background: rgba(146, 54, 65, 0.12);
  color: #8c3340;
  border: 1px solid rgba(140, 51, 64, 0.12);
}

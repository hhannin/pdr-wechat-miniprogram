.record-shell {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.record-scroll {
  flex: 1;
  height: 100%;
}

.record-form {
  padding: 16rpx 28rpx 0;
}

.record-section {
  margin-bottom: 28rpx;
  background: var(--color-card, #fffbf5);
  border: 1rpx solid var(--color-border, #ece3d3);
  border-radius: var(--radius-card, 20rpx);
  padding: 24rpx 28rpx;
}

.record-section-label {
  font-size: var(--font-sm, 26rpx);
  color: var(--color-text-secondary, #8a8578);
  margin-bottom: 12rpx;
}

/* Location CTA */
.record-location-cta {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0;
}

.record-location-cta-icon {
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 16rpx;
}

.record-location-cta-text {
  font-size: var(--font-lg, 30rpx);
  font-weight: 500;
  color: var(--color-brand, #1f6a46);
}

/* Location card */
.record-location-card {
  padding: 8rpx 0;
}

.record-location-title {
  font-size: var(--font-lg, 30rpx);
  color: var(--color-text-primary, #2d2a1f);
  font-weight: 500;
}

.record-location-subtitle {
  margin-top: 6rpx;
  font-size: var(--font-sm, 26rpx);
  color: var(--color-text-secondary, #8a8578);
}

.record-location-card-disabled {
  opacity: 0.55;
}

/* Textarea */
.record-textarea {
  width: 100%;
  height: 160rpx;
  font-size: var(--font-lg, 30rpx);
  color: var(--color-text-primary, #2d2a1f);
  line-height: 1.6;
}

/* Reminder */
.record-reminder-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.record-reminder-label {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: var(--font-lg, 30rpx);
  color: var(--color-text-primary, #2d2a1f);
}

.record-reminder-icon {
  width: 36rpx;
  height: 36rpx;
}

.record-reminder-pickers {
  margin-top: 16rpx;
  display: flex;
  gap: 20rpx;
}

.record-reminder-pickers > picker {
  flex: 1;
}

.record-reminder-picker {
  background: var(--color-bg, #f4efe5);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.record-reminder-picker-label {
  font-size: var(--font-xs, 22rpx);
  color: var(--color-text-secondary, #8a8578);
}

.record-reminder-picker-value {
  margin-top: 4rpx;
  font-size: var(--font-md, 28rpx);
  color: var(--color-text-primary, #2d2a1f);
}

/* More clues */
.record-more-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.record-more-title {
  font-size: var(--font-lg, 30rpx);
  color: var(--color-text-primary, #2d2a1f);
}

.record-more-chevron {
  width: 32rpx;
  height: 32rpx;
  transition: transform 0.2s;
}

.record-more-chevron-open {
  transform: rotate(180deg);
}

.record-more-body {
  margin-top: 20rpx;
}

.record-sub-section {
  margin-bottom: 24rpx;
}

.record-sub-section:last-child {
  margin-bottom: 0;
}

.record-sub-label {
  font-size: var(--font-sm, 26rpx);
  color: var(--color-text-secondary, #8a8578);
  margin-bottom: 12rpx;
}

/* Photo */
.record-photo {
  position: relative;
  display: block;
  width: 400rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.record-photo-image {
  display: block;
  width: 400rpx;
  border-radius: 12rpx;
}

.record-photo-remove {
  position: absolute;
  right: 12rpx;
  top: 12rpx;
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 24rpx;
}

.record-photo-remove-icon {
  width: 28rpx;
  height: 28rpx;
}

.record-photo-cta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 0;
}

.record-photo-cta-icon {
  width: 40rpx;
  height: 40rpx;
}

.record-photo-cta-text {
  font-size: var(--font-md, 28rpx);
  color: var(--color-brand, #1f6a46);
}

/* Scene select */
.record-scene-select {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 20rpx;
  background: var(--color-bg, #f4efe5);
  border-radius: 12rpx;
}

.record-scene-select-disabled {
  opacity: 0.6;
}

.record-scene-select-value {
  font-size: var(--font-md, 28rpx);
  color: var(--color-text-primary, #2d2a1f);
}

.record-scene-select-chevron {
  width: 28rpx;
  height: 28rpx;
  transition: transform 0.2s;
}

.record-scene-select-chevron-open {
  transform: rotate(180deg);
}

.record-scene-dropdown {
  margin-top: 8rpx;
  background: var(--color-card, #fffbf5);
  border: 1rpx solid var(--color-border, #ece3d3);
  border-radius: 12rpx;
  overflow: hidden;
}

.record-scene-dropdown-item {
  padding: 20rpx 24rpx;
  font-size: var(--font-md, 28rpx);
  color: var(--color-text-primary, #2d2a1f);
  border-bottom: 1rpx solid var(--color-border, #ece3d3);
}

.record-scene-dropdown-item:last-child {
  border-bottom: none;
}

.record-scene-dropdown-item-active {
  color: var(--color-brand, #1f6a46);
  font-weight: 500;
}

/* Field input */
.record-field-input {
  padding: 16rpx 20rpx;
  background: var(--color-bg, #f4efe5);
  border-radius: 12rpx;
  font-size: var(--font-md, 28rpx);
  color: var(--color-text-primary, #2d2a1f);
}

.record-field-suggestions {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.record-field-suggestion {
  padding: 8rpx 20rpx;
  background: var(--color-bg, #f4efe5);
  border-radius: 20rpx;
  font-size: var(--font-sm, 26rpx);
  color: var(--color-text-secondary, #8a8578);
}

.record-field-suggestion-active {
  background: var(--color-brand, #1f6a46);
  color: #fff;
}

/* Padding */
.record-form-pad {
  height: calc(140rpx + env(safe-area-inset-bottom));
}

/* Save bar */
.record-save-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 16rpx 28rpx calc(16rpx + env(safe-area-inset-bottom));
  background: rgba(244, 239, 229, 0.92);
  backdrop-filter: blur(8px);
}

.record-save-bar-buttons {
  display: flex;
  gap: 20rpx;
}

.record-save-button {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: var(--font-lg, 30rpx);
  font-weight: 500;
  color: #fff;
  background: var(--color-brand, #1f6a46);
  border-radius: 16rpx;
  border: none;
  padding: 0;
  margin: 0;
}

.record-save-button-disabled {
  background: var(--color-text-secondary, #8a8578);
  opacity: 0.5;
}

.record-save-button::after {
  border: none;
}

.record-delete-button {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  font-size: var(--font-lg, 30rpx);
  font-weight: 500;
  color: #fff;
  background: var(--color-danger, #b34040);
  border-radius: 16rpx;
  border: none;
  padding: 0;
  margin: 0;
}

.record-delete-button[disabled] {
  background: var(--color-danger, #b34040);
  color: #fff;
  opacity: 0.5;
}

.record-delete-button::after {
  border: none;
}

/* Empty */
.record-empty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.record-empty-title {
  font-size: var(--font-lg, 30rpx);
  color: var(--color-text-primary, #2d2a1f);
}

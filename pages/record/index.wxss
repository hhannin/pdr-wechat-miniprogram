.page-shell {
  min-height: 100vh;
  padding: 18rpx 28rpx 72rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top right, rgba(199, 141, 63, 0.18), transparent 32%),
    radial-gradient(circle at top left, rgba(31, 106, 70, 0.12), transparent 28%),
    linear-gradient(180deg, #fbf7f1 0%, #f4efe5 62%, #efe8da 100%);
  color: #223c2b;
}

.status-card,
.section-card,
.meta-card,
.loading-card {
  background: rgba(255, 251, 245, 0.92);
  border: 1px solid rgba(34, 60, 43, 0.1);
  border-radius: 32rpx;
  box-shadow: 0 22rpx 54rpx rgba(49, 42, 27, 0.1);
}

.section-card,
.meta-card,
.loading-card {
  padding: 30rpx 28rpx;
  margin-bottom: 24rpx;
}

.status-card {
  padding: 22rpx 24rpx;
  margin-bottom: 24rpx;
}

.section-head,
.field-head,
.button-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  flex-wrap: wrap;
}

.record-chip,
.field-badge {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.record-strip {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.record-chip {
  background: rgba(31, 106, 70, 0.12);
  color: #174f35;
}

.record-chip-muted,
.field-badge {
  background: rgba(199, 141, 63, 0.14);
  color: #7a5225;
}

.hero-subtitle,
.section-desc,
.field-desc,
.note-text,
.meta-label,
.status-line,
.meta-value {
  font-size: 25rpx;
  line-height: 1.7;
  color: rgba(34, 60, 43, 0.68);
}

.status-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.status-busy {
  color: #6a7d96;
}

.status-success {
  color: #20563a;
}

.status-error {
  color: #8c3340;
}

.section-title,
.field-title {
  font-size: 31rpx;
  font-weight: 700;
  color: #223c2b;
}

.section-desc {
  margin-top: 8rpx;
}

.photo-card {
  padding: 22rpx;
}

.photo-stage {
  position: relative;
  min-height: 520rpx;
  border-radius: 28rpx;
  background:
    linear-gradient(180deg, rgba(244, 239, 229, 0.78), rgba(250, 246, 239, 0.96));
  border: 1px solid rgba(34, 60, 43, 0.08);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-stage-empty {
  border-style: dashed;
}

.photo-stage-tappable {
  transition: transform 160ms ease, box-shadow 160ms ease;
}

.photo-stage-disabled {
  opacity: 0.7;
}

.stage-clear {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  z-index: 3;
  width: 52rpx;
  height: 52rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(34, 60, 43, 0.58);
  color: #fffaf3;
  font-size: 34rpx;
  line-height: 1;
}

.photo-empty-shell {
  width: 100%;
  min-height: 520rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 36rpx;
  box-sizing: border-box;
}

.photo-empty-icon {
  width: 196rpx;
  height: 196rpx;
}

.photo-preview {
  width: 100%;
  height: 520rpx;
  display: block;
}

.photo-meta-row {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.photo-meta {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(34, 60, 43, 0.66);
}

.meta-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
}

.meta-item {
  padding: 18rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(244, 239, 229, 0.7);
  border: 1px solid rgba(34, 60, 43, 0.06);
}

.meta-value {
  margin-top: 6rpx;
  color: #223c2b;
}

.field-static,
.note-view,
.field-input,
.note-input {
  margin-top: 18rpx;
  border-radius: 24rpx;
  background: rgba(244, 239, 229, 0.76);
  border: 1px solid rgba(34, 60, 43, 0.08);
}

.field-static,
.note-view {
  padding: 22rpx 20rpx;
}

.location-title,
.field-static-value {
  font-size: 29rpx;
  line-height: 1.5;
  font-weight: 600;
  color: #223c2b;
}

.field-input {
  width: 100%;
  height: 88rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
  color: #223c2b;
  font-size: 27rpx;
}

.location-card {
  padding: 26rpx 24rpx;
}

.location-stage {
  position: relative;
  border-radius: 28rpx;
  background:
    linear-gradient(180deg, rgba(244, 239, 229, 0.78), rgba(250, 246, 239, 0.96));
  border: 1px solid rgba(34, 60, 43, 0.08);
  padding: 28rpx 24rpx;
}

.location-stage-disabled {
  opacity: 0.7;
}

.location-stage-shell,
.location-shell {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.location-stage-icon,
.location-icon {
  flex: 0 0 68rpx;
  width: 68rpx;
  height: 68rpx;
  margin-top: 4rpx;
}

.location-stage-copy,
.location-copy {
  flex: 1;
  min-width: 0;
}

.location-subtitle,
.location-source {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(34, 60, 43, 0.66);
}

.location-footer {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.note-input {
  width: 100%;
  min-height: 180rpx;
  padding: 20rpx;
  box-sizing: border-box;
  color: #223c2b;
  font-size: 27rpx;
  line-height: 1.7;
}

.placeholder-text {
  color: rgba(34, 60, 43, 0.42);
}

.field-block + .field-block {
  margin-top: 22rpx;
}

.note-meta {
  margin-top: 12rpx;
  font-size: 23rpx;
  line-height: 1.5;
  color: rgba(34, 60, 43, 0.58);
}

.suggestion-wrap {
  margin-top: 14rpx;
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.suggestion-chip {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  border: 1px solid rgba(31, 106, 70, 0.14);
  background: rgba(255, 255, 255, 0.55);
  color: #335440;
  font-size: 22rpx;
  line-height: 1.3;
}

.suggestion-chip-active {
  border-color: rgba(31, 106, 70, 0.34);
  background: rgba(31, 106, 70, 0.12);
  color: #174f35;
}

.action-stack {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 6rpx;
}

.ghost-button,
.inline-button,
.primary-button,
.soft-button,
.outline-button,
.danger-button {
  width: 100%;
  border-radius: 999rpx;
}

.ghost-button,
.inline-button {
  width: auto;
  min-width: 0;
  padding: 0 24rpx;
}

.primary-button {
  background: linear-gradient(135deg, #1f6a46, #2b7c55);
  color: #f7fff9;
}

.soft-button {
  background: rgba(31, 106, 70, 0.12);
  color: #174f35;
}

.outline-button {
  background: rgba(255, 255, 255, 0.72);
  color: #223c2b;
  border: 1px solid rgba(34, 60, 43, 0.08);
}

.ghost-button {
  background: rgba(255, 255, 255, 0.72);
  color: #223c2b;
  border: 1px solid rgba(34, 60, 43, 0.08);
}

.inline-button {
  background: rgba(31, 106, 70, 0.12);
  color: #174f35;
}

.danger-button {
  background: rgba(146, 54, 65, 0.12);
  color: #8c3340;
  border: 1px solid rgba(140, 51, 64, 0.12);
}

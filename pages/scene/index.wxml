<view class="page-shell">
  <view class="scene-list">
    <block wx:for="{{sceneCards}}" wx:key="sceneType" wx:for-item="sceneCard">
      <navigator
        class="scene-card"
        url="{{sceneCard.createUrl}}"
      >
        <view class="scene-card-head">
          <view class="scene-card-kicker">{{sceneCard.eyebrow}}</view>
          <view class="scene-card-arrow">></view>
        </view>
        <view class="scene-card-title">{{sceneCard.label}}</view>
        <view class="scene-card-summary">{{sceneCard.summary}}</view>
      </navigator>
    </block>
  </view>

  <view class="footer-nav">
    <block wx:for="{{footerNavItems}}" wx:key="key" wx:for-item="navItem">
      <navigator
        class="footer-nav-item {{navItem.isActive ? 'footer-nav-item-active' : ''}}"
        url="{{navItem.path}}"
        open-type="redirect"
      >
        <view class="footer-nav-label">{{navItem.label}}</view>
      </navigator>
    </block>
  </view>
</view>

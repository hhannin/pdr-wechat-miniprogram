.page-shell {
  min-height: 100vh;
  padding: 22rpx 28rpx 224rpx;
  box-sizing: border-box;
  background:
    radial-gradient(circle at top right, rgba(199, 141, 63, 0.18), transparent 34%),
    radial-gradient(circle at top left, rgba(31, 106, 70, 0.1), transparent 28%),
    linear-gradient(180deg, #fbf7f1 0%, #f4efe5 62%, #efe8da 100%);
  color: #223c2b;
}

.scene-card {
  position: relative;
  overflow: hidden;
  background: rgba(255, 251, 245, 0.92);
  border: 1px solid rgba(34, 60, 43, 0.1);
  border-radius: 32rpx;
  box-shadow: 0 22rpx 54rpx rgba(49, 42, 27, 0.1);
}

.scene-card-kicker {
  display: inline-flex;
  align-items: center;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(31, 106, 70, 0.12);
  color: #174f35;
  font-size: 22rpx;
  letter-spacing: 0.08em;
}

.scene-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.scene-card {
  display: block;
  min-height: 188rpx;
  padding: 30rpx 28rpx;
  transition: transform 160ms ease, box-shadow 160ms ease;
}

.scene-card-pressed {
  transform: translateY(2rpx);
}

.scene-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.scene-card-arrow {
  width: 48rpx;
  height: 48rpx;
  border-radius: 999rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  background: rgba(31, 106, 70, 0.1);
  color: #1f6a46;
  font-size: 30rpx;
  font-weight: 700;
}

.scene-card-title {
  margin-top: 18rpx;
  font-size: 38rpx;
  line-height: 1.2;
  font-weight: 700;
}

.scene-card-summary {
  margin-top: 12rpx;
  font-size: 25rpx;
  line-height: 1.5;
  color: rgba(34, 60, 43, 0.68);
}

.footer-nav {
  position: fixed;
  left: 28rpx;
  right: 28rpx;
  bottom: calc(constant(safe-area-inset-bottom) + 28rpx);
  bottom: 28rpx;
  bottom: calc(env(safe-area-inset-bottom) + 28rpx);
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  padding: 14rpx;
  border-radius: 28rpx;
  background: rgba(255, 252, 247, 0.92);
  border: 1px solid rgba(34, 60, 43, 0.08);
  box-shadow: 0 20rpx 56rpx rgba(44, 38, 27, 0.16);
}

.footer-nav-item {
  display: block;
  padding: 20rpx 16rpx;
  border-radius: 22rpx;
  background: transparent;
  text-align: center;
}

.footer-nav-item-active {
  background: linear-gradient(135deg, rgba(31, 106, 70, 0.12), rgba(199, 141, 63, 0.12));
}

.footer-nav-item-pressed {
  transform: translateY(1rpx);
}

.footer-nav-label {
  font-size: 28rpx;
  font-weight: 700;
  color: #223c2b;
}

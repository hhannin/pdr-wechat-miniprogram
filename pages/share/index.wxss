@import "../record/index.wxss";

.page-shell {
  padding-bottom: 48rpx;
}

.share-page-topbar {
  grid-template-columns: 1fr auto 1fr;
}

.share-topbar-action-placeholder {
  visibility: hidden;
}

.share-image-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  text-align: center;
}

.share-image-fallback-icon {
  width: 92rpx;
  height: 92rpx;
}

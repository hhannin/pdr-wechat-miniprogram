<view class="share-shell">
  <top-toolbar title="查看分享速记" />

  <view wx:if="{{pageStatus === 'loading'}}" class="share-status">
    <view class="share-status-title">载入中…</view>
    <view class="share-status-subtitle">正在读取分享内容</view>
  </view>

  <view wx:elif="{{pageStatus === 'requires_network'}}" class="share-status">
    <view class="share-status-title">首次打开需要联网</view>
    <view class="share-status-subtitle">当前设备里还没有这份分享缓存，请联网后再打开一次。</view>
  </view>

  <view wx:elif="{{pageStatus === 'expired'}}" class="share-status">
    <view class="share-status-title">分享已过期</view>
    <view class="share-status-subtitle">这份分享内容已经失效，当前不能继续查看。</view>
  </view>

  <scroll-view wx:elif="{{pageStatus === 'ready'}}" class="share-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="share-body">
      <post-card
        view="{{postView}}"
        mode="share"
        bindphototap="handlePhotoTap"
        bindnavigatetap="handleOpenLocation"
      />
    </view>
  </scroll-view>

  <view class="share-home-bar">
    <view class="share-home-button" bindtap="handleBackHome" hover-class="share-home-button-hover">
      返回小程序主页
    </view>
  </view>
</view>

.post-card {
  position: relative;
  display: flex;
  flex-direction: column;
  padding: 28rpx 32rpx;
  margin: 0 24rpx var(--gap-card, 22rpx);
  background-color: var(--color-card, #fffbf5);
  border-radius: var(--radius-card, 20rpx);
  border: 1rpx solid var(--color-border, #ece3d3);
  box-shadow: var(--shadow-card, 0 6rpx 24rpx rgba(60, 48, 20, 0.06));
  transition: opacity 220ms ease, transform 220ms ease;
}

.post-card-detail,
.post-card-share {
  margin-top: 24rpx;
}

.post-card-pressed {
  background-color: #fbf5e8;
}

.post-card-fading {
  opacity: 0;
  transform: translateY(-8rpx);
}

.post-card-headline {
  font-size: var(--font-lg, 30rpx);
  line-height: 1.5;
  color: var(--color-text-primary, #2d2a1f);
  font-weight: 500;
  word-break: break-all;
}

.post-card-headline-clamp {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-card-note {
  margin-top: 12rpx;
  font-size: var(--font-md, 28rpx);
  line-height: 1.55;
  color: var(--color-text-primary, #2d2a1f);
  white-space: pre-wrap;
  word-break: break-all;
}

.post-card-note-clamp {
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-card-photo-wrap {
  display: block;
  margin-top: 18rpx;
  margin-left: 0;
  margin-right: auto;
  align-self: flex-start;
  width: 400rpx;
  max-height: 540rpx;
  border-radius: var(--radius-photo, 12rpx);
  overflow: hidden;
}

.post-card-detail .post-card-photo-wrap,
.post-card-share .post-card-photo-wrap {
  width: 560rpx;
  max-width: 100%;
  max-height: 720rpx;
}

.post-card-photo-wrap-fallback {
  height: 540rpx;
}

.post-card-detail .post-card-photo-wrap-fallback,
.post-card-share .post-card-photo-wrap-fallback {
  height: 720rpx;
}

.post-card-photo {
  width: 100%;
  display: block;
}

.post-card-photo-wrap-fallback .post-card-photo {
  height: 100%;
}

.post-card-divider {
  margin-top: 22rpx;
  height: 1rpx;
  background-color: var(--color-divider, #efe7d6);
}

.post-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  min-height: 56rpx;
}

.post-card-meta {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.post-card-detail .post-card-meta {
  flex-direction: column;
  align-items: flex-start;
  gap: 8rpx;
}

.post-card-time {
  font-size: var(--font-xs, 24rpx);
  color: var(--color-text-secondary, #8a8578);
}

.post-card-alarm-badge {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 4rpx 14rpx 4rpx 10rpx;
  border-radius: 999rpx;
  background-color: rgba(31, 106, 70, 0.08);
}

.post-card-alarm-badge-gray {
  background-color: rgba(120, 115, 105, 0.1);
}

.post-card-alarm-badge-neutral {
  background-color: rgba(120, 115, 105, 0.1);
}

.post-card-alarm {
  width: 26rpx;
  height: 26rpx;
}

.post-card-alarm-text {
  font-size: var(--font-xs, 24rpx);
  color: var(--color-brand, #1f6a46);
  line-height: 1;
}

.post-card-alarm-badge-gray .post-card-alarm-text {
  color: var(--color-text-secondary, #8a8578);
}

.post-card-alarm-text-neutral {
  color: var(--color-text-secondary, #8a8578);
}

.post-card-actions {
  display: flex;
  align-items: center;
}

.post-card-action {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 60rpx;
  height: 60rpx;
  margin-left: 4rpx;
  border-radius: 30rpx;
  transition: background-color 160ms ease;
}

.post-card-action:first-child {
  margin-left: 0;
}

.post-card-action-pressed {
  background-color: rgba(31, 106, 70, 0.1);
}

.post-card-action-icon {
  width: 32rpx;
  height: 32rpx;
  transition: transform 180ms ease;
}

.post-card-action-icon-bump {
  transform: scale(1.08);
}

.post-card-action-icon-rotated {
  transform: rotate(90deg);
}

.post-card-elevated {
  z-index: 60;
}

.post-card-backdrop {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 50;
  background: transparent;
}

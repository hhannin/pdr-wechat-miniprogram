.share-sheet-overlay {
  position: fixed;
  inset: 0;
  z-index: 60;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}

.share-sheet-backdrop {
  position: absolute;
  inset: 0;
  background: rgba(20, 18, 12, 0.48);
}

.share-sheet {
  position: relative;
  background: var(--color-card, #fffbf5);
  border-top-left-radius: 32rpx;
  border-top-right-radius: 32rpx;
  padding: 16rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  max-height: 70vh;
  display: flex;
  flex-direction: column;
}

.share-sheet-handle {
  width: 80rpx;
  height: 6rpx;
  background: #ded4bf;
  border-radius: 6rpx;
  align-self: center;
  margin-bottom: 12rpx;
}

.share-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0 20rpx;
  border-bottom: 1rpx solid var(--color-divider, #efe7d6);
}

.share-sheet-title {
  font-size: var(--font-lg, 30rpx);
  font-weight: 600;
  color: var(--color-text-primary, #2d2a1f);
}

.share-sheet-close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
}

.share-sheet-close-pressed {
  background: rgba(45, 42, 31, 0.08);
}

.share-sheet-close-icon {
  width: 36rpx;
  height: 36rpx;
}

.share-sheet-body {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 0;
}

.share-sheet-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 4rpx;
  border-bottom: 1rpx solid rgba(239, 231, 214, 0.6);
}

.share-sheet-row:last-child {
  border-bottom: none;
}

.share-sheet-row-pressed {
  background: rgba(31, 106, 70, 0.05);
}

.share-sheet-row-locked {
  opacity: 0.85;
}

.share-sheet-label {
  font-size: var(--font-md, 28rpx);
  color: var(--color-text-primary, #2d2a1f);
}

.share-sheet-check {
  width: 44rpx;
  height: 44rpx;
  border-radius: 22rpx;
  border: 2rpx solid #d9d3c5;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fff;
}

.share-sheet-check-active {
  background: var(--color-brand, #1f6a46);
  border-color: var(--color-brand, #1f6a46);
}

.share-sheet-check-mark {
  color: #fffbf5;
  font-size: 28rpx;
  line-height: 1;
}

.share-sheet-footer {
  padding-top: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.share-sheet-button {
  box-sizing: border-box;
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-md, 28rpx);
  font-weight: 400;
  padding: 0;
  margin: 0;
  border: none;
  line-height: 96rpx;
  min-height: 0;
}

.share-sheet-button::after {
  display: none;
}

.share-sheet-button-primary {
  background: var(--color-brand, #1f6a46);
  color: #fffbf5;
}

.share-sheet-button-pressed {
  opacity: 0.84;
}

.share-sheet-button[loading] {
  background: var(--color-brand, #1f6a46);
  color: #fffbf5;
}

.share-sheet-hint {
  margin-top: 16rpx;
  font-size: var(--font-xs, 24rpx);
  color: var(--color-text-secondary, #8a8578);
}

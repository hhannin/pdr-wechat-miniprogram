.post-view-shell {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-top: 88rpx;
}

.post-view-scroll {
  flex: 1;
  height: 100%;
}

.post-view-body {
  padding: 16rpx 0 calc(60rpx + env(safe-area-inset-bottom));
}

.post-view-empty {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
  text-align: center;
}

.post-view-empty-title {
  font-size: var(--font-lg, 30rpx);
  color: var(--color-text-primary, #2d2a1f);
  font-weight: 500;
}

.post-view-empty-subtitle {
  margin-top: 16rpx;
  font-size: var(--font-md, 28rpx);
  color: var(--color-text-secondary, #8a8578);
}

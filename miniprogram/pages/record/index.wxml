<view class="record-shell">
  <top-toolbar
    title="{{isEditMode ? '编辑速记' : '创建速记'}}"
    right-icon="{{isEditMode ? '' : '/assets/icons/ic-list-line.svg'}}"
    bindrighttap="handleGoList"
  />
  <scroll-view wx:if="{{pageReady}}" class="record-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="record-form">

      <!-- 位置 -->
      <view class="record-section">
        <view wx:if="{{!hasLocation}}" class="record-location-cta" bindtap="handlePickLocation">
          <image class="record-location-cta-icon" src="/assets/icons/ic-map-pin-line.svg" mode="aspectFit" />
          <view class="record-location-cta-text">选择位置</view>
        </view>
        <view wx:else class="record-location-card {{isEditMode ? 'record-location-card-disabled' : ''}}" bindtap="handlePickLocation">
          <view class="record-location-title">{{locationTitle}}</view>
          <view wx:if="{{locationSubtitle}}" class="record-location-subtitle">{{locationSubtitle}}</view>
        </view>
      </view>

      <!-- 备注 -->
      <view class="record-section">
        <view class="record-section-label">备注</view>
        <textarea
          wx:if="{{textareaReady}}"
          class="record-textarea"
          value="{{noteValue}}"
          placeholder="再多记录一些"
          maxlength="500"
          adjust-position="{{true}}"
          hold-keyboard="{{true}}"
          bindinput="handleNoteInput"
        />
      </view>

      <!-- 提醒 -->
      <view class="record-section">
        <view class="record-reminder-head">
          <view class="record-reminder-label">
            <image class="record-reminder-icon" src="/assets/icons/ic-alarm-gray.svg" mode="aspectFit" />
            <text>提醒</text>
          </view>
          <switch
            class="record-reminder-switch"
            checked="{{reminderEnabled}}"
            color="#1f6a46"
            bindchange="handleReminderToggle"
          />
        </view>
        <view wx:if="{{reminderEnabled}}" class="record-reminder-pickers">
          <picker
            mode="date"
            value="{{reminderPickerDate}}"
            start="{{reminderPickerMinDate}}"
            bindchange="handleReminderDateChange"
          >
            <view class="record-reminder-picker">
              <view class="record-reminder-picker-label">日期</view>
              <view class="record-reminder-picker-value">{{reminderPickerDate || '请选择'}}</view>
            </view>
          </picker>
          <picker
            mode="time"
            value="{{reminderPickerTime}}"
            bindchange="handleReminderTimeChange"
          >
            <view class="record-reminder-picker">
              <view class="record-reminder-picker-label">时间</view>
              <view class="record-reminder-picker-value">{{reminderPickerTime || '请选择'}}</view>
            </view>
          </picker>
        </view>
      </view>

      <!-- 更多线索 -->
      <view class="record-section">
        <view class="record-more-head" bindtap="handleToggleMoreClues">
          <view class="record-more-title">更多线索</view>
          <image
            class="record-more-chevron {{moreCluesExpanded ? 'record-more-chevron-open' : ''}}"
            src="/assets/icons/ic-chevron-down.svg"
            mode="aspectFit"
          />
        </view>

        <view wx:if="{{moreCluesExpanded}}" class="record-more-body">
          <!-- 照片 -->
          <view class="record-sub-section">
            <view class="record-sub-label">照片</view>
            <block wx:if="{{hasPhoto}}">
              <view class="record-photo">
                <image
                  class="record-photo-image"
                  src="{{photoPath}}"
                  mode="widthFix"
                  bindtap="handlePreviewPhoto"
                />
                <view wx:if="{{!isEditMode || !currentItemHasPhoto}}" class="record-photo-remove" catchtap="handleClearPhoto">
                  <image class="record-photo-remove-icon" src="/assets/icons/ic-close-line.svg" mode="aspectFit" />
                </view>
              </view>
            </block>
            <view wx:else class="record-photo-cta" bindtap="handleCapturePhoto">
              <image class="record-photo-cta-icon" src="/assets/icons/ic-camera-line.svg" mode="aspectFit" />
              <view class="record-photo-cta-text">添加照片</view>
            </view>
          </view>

          <!-- 场景 -->
          <view class="record-sub-section">
            <view class="record-sub-label">场景</view>
            <view
              class="record-scene-select {{isEditMode ? 'record-scene-select-disabled' : ''}}"
              bindtap="handleToggleSceneDropdown"
            >
              <view class="record-scene-select-value">{{sceneLabel}}</view>
              <image
                wx:if="{{!isEditMode}}"
                class="record-scene-select-chevron {{sceneDropdownVisible ? 'record-scene-select-chevron-open' : ''}}"
                src="/assets/icons/ic-chevron-down.svg"
                mode="aspectFit"
              />
            </view>
            <view wx:if="{{sceneDropdownVisible}}" class="record-scene-dropdown">
              <block wx:for="{{sceneOptions}}" wx:key="type" wx:for-item="option">
                <view
                  class="record-scene-dropdown-item {{option.type === sceneType ? 'record-scene-dropdown-item-active' : ''}}"
                  data-scene-type="{{option.type}}"
                  bindtap="handlePickSceneType"
                >{{option.label}}</view>
              </block>
            </view>
          </view>

          <!-- 场景线索字段 -->
          <block wx:if="{{fieldViews.length > 0}}">
            <view wx:for="{{fieldViews}}" wx:key="key" wx:for-item="fieldView" class="record-sub-section">
              <view class="record-sub-label">{{fieldView.label}}</view>
              <input
                class="record-field-input"
                value="{{fieldView.value}}"
                placeholder="{{fieldView.placeholder}}"
                maxlength="{{fieldView.maxLength}}"
                data-field-key="{{fieldView.key}}"
                bindinput="handleFieldInput"
              />
              <view wx:if="{{fieldView.suggestions.length > 0}}" class="record-field-suggestions">
                <block wx:for="{{fieldView.suggestions}}" wx:key="value" wx:for-item="suggestion">
                  <view
                    class="record-field-suggestion {{suggestion.isActive ? 'record-field-suggestion-active' : ''}}"
                    data-field-key="{{fieldView.key}}"
                    data-suggestion-value="{{suggestion.value}}"
                    bindtap="handleFieldSuggestionTap"
                  >{{suggestion.label}}</view>
                </block>
              </view>
            </view>
          </block>
        </view>
      </view>

      <view class="record-form-pad"></view>
    </view>
  </scroll-view>

  <view wx:if="{{!pageReady}}" class="record-empty">
    <view class="record-empty-title">载入中…</view>
  </view>

  <view wx:if="{{pageReady}}" class="record-save-bar">
    <view class="record-save-bar-buttons">
      <button
        class="record-save-button {{canSave ? '' : 'record-save-button-disabled'}}"
        disabled="{{!canSave || busy}}"
        loading="{{busy}}"
        bindtap="handleSave"
      >{{busy ? '保存中' : '保存'}}</button>
      <button
        wx:if="{{isEditMode}}"
        class="record-delete-button"
        disabled="{{busy}}"
        bindtap="handleDelete"
      >删除</button>
    </view>
  </view>
</view>

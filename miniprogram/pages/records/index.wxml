<view class="records-shell">
  <top-toolbar
    title="速记列表"
    left-icon="/assets/icons/ic-bookmark-line.svg"
    right-icon="/assets/icons/ic-plus-line.svg"
    bindlefttap="handleGoFavorites"
    bindrighttap="handleGoCreate"
  />

  <view wx:if="{{!pageReady}}" class="records-empty">
    <view class="records-empty-title">载入中…</view>
  </view>

  <block wx:elif="{{!hasItems}}">
    <view class="records-empty">
      <view class="records-empty-title">还没有记录</view>
      <view class="records-empty-subtitle">返回首页创建第一条速记</view>
    </view>
  </block>

  <scroll-view
    wx:else
    class="records-scroll"
    scroll-y
    scroll-into-view="{{scrollIntoViewId}}"
    scroll-with-animation
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="records-list">
      <block wx:for="{{postViews}}" wx:key="id" wx:for-item="postView">
        <view id="post-{{postView.id}}" class="records-item">
          <post-card
            view="{{postView}}"
            mode="list"
            fading="{{fadingIds[postView.id]}}"
            bindcardtap="handleCardTap"
            bindphototap="handlePhotoTap"
            bindnavigatetap="handleNavigateTap"
            bindsharetap="handleShareTap"
            bindfavoritetap="handleFavoriteTap"
            bindedittap="handleEditTap"
            binddeletetap="handleDeleteTap"
          />
        </view>
      </block>
      <view class="records-list-bottom-pad"></view>
    </view>
  </scroll-view>

  <date-scrubber
    wx:if="{{hasItems}}"
    date-keys="{{dateKeys}}"
    binddatechange="handleDateChange"
  />

  <share-sheet
    visible="{{shareFlowVisible}}"
    selection-items="{{shareSelectionItems}}"
    prepare-state="{{sharePrepareState}}"
    bindclose="handleShareClose"
    bindtoggle="handleShareToggle"
    bindretry="handleShareRetry"
  />
</view>
